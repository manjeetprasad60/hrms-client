# ==============================================================================
# HRIS Client Admin Web — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your local development environment.
# DO NOT commit .env or .env.local files containing project credentials.
#
# Supported Environments:
# - development: Local developer workflow with live or emulator Firebase services
# - staging: Pre-production verification linked to staging Firebase project
# - production: High-availability live client portal
# ==============================================================================

# Application Environment Mode ('development' | 'staging' | 'production' | 'test')
VITE_APP_NAME="HRIS Client Admin"
VITE_APP_ENV="development"
VITE_API_BASE_URL=""

# ==============================================================================
# Firebase Web Configuration
# ==============================================================================
# In Firebase architecture, web configuration values are public identifiers used
# to route browser requests to the correct project. They are NOT secrets.
#
# Real security is strictly enforced by:
# 1. Firebase Authentication tokens
# 2. Firebase Realtime Database Security Rules (scoped per organizationId)
# 3. Cloud Storage Security Rules (scoped per organizationId)
#
# Required parameters for:
# - Firebase Authentication (email/password, sessions)
# - Firebase Realtime Database (workforce telemetry, audit logs)
# - Firebase Storage (documents, avatars, reports)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
